#!/usr/bin/env bash
set -euo pipefail

echo "🔍 Running pre-commit checks..."

# 1. Formatting check
echo "  → just fmt"
if ! just fmt 2>&1; then
    echo ""
    echo "❌ Formatting check failed. Run 'just fmt-fix' to fix."
    exit 1
fi

# 2. Clippy (warnings as errors)
echo "  → just lint"
if ! just lint 2>&1; then
    echo ""
    echo "❌ Clippy check failed. Fix the warnings above."
    exit 1
fi

echo "✅ Pre-commit checks passed."
